# Scripted GUI test (run by CI: DAEDALUS_SCRIPT=this file, DaedalusEngine.exe tools/gui_test/gui.psimx --shot <prefix>)
# Checked by tools/gui_test/check.js; screenshots are kept as a CI artifact.
wait 40
fit
wait 10
shot 01_start
dump 01_start

# paste a label: a grey ghost follows the mouse until the click
wmove 6.6 2
click left
wait 4
key C ctrl
key V ctrl
wmove 10 8
wait 6
shot 02_paste_ghost
dump 02_paste_ghost
click left
wait 4
dump 03_pasted
key Escape

# rotate the label: Space, then Ctrl+R
wmove 6.6 2
click left
wait 4
key Space
wait 4
dump 04_label_space
key R ctrl
wait 4
dump 05_label_ctrlR
shot 05_label_ctrlR

# right-click menu: items must react
wmove 1.7 2.2
click right
wait 6
shot 06_ctxmenu
dump 06_ctxmenu
menu 旋轉
wait 6
dump 07_ctx_rotated
wmove 1.7 2.2
click right
wait 6
menu 上下鏡像
wait 6
dump 08_ctx_flipped
# undo the two R1 edits (R1 must be connected again for the simulation below)
key Escape
key Z ctrl
key Z ctrl
wait 4
dump 08b_undo

# hand tool: left-drag moves the view
key H
wait 3
dump 09_hand
drag 0 -2 4 2
wait 6
dump 10_hand_dragged
key Escape
wait 3

# element shortcuts
wmove 16 8
key R
wait 4
dump 11_key_R
shot 11_key_R
key Escape
key C
wait 3
dump 12_key_C
key Escape
key L
wait 3
dump 13_key_L
key Escape
key D
wait 3
dump 14_key_D
key Escape
key P
wait 3
dump 15_key_P
key Escape
key N
wait 3
dump 16_key_N
key Escape
key G
wait 3
dump 17_key_G
key Escape
wait 3

# probe copy/paste: clicked on the symbol (view reset first: the hand / right-drag tests moved it)
fit
wait 6
wmove 5 -0.3
click left
wait 4
key C ctrl
key V ctrl
wmove 12 8
wait 6
dump 18_probe_paste
shot 18_probe_paste
click left
wait 4
dump 18b_probe_placed
key Escape
key Escape
# probe selected through its name text: the first click only selects, so Ctrl+C / Ctrl+V paste the probe
wait 30
textmove 5
click left
wait 4
dump 19_probe_text
key C ctrl
key V ctrl
wmove 16 4
wait 6
dump 19b_probe_text_paste
click left
wait 4
key Escape
key Escape
# a click on the text of the element that is already selected edits it in place
wait 30
textmove 5
click left
wait 40
textmove 5
click left
wait 4
dump 19c_text_edit
shot 19c_text_edit
close_dialogs
key Escape
wait 3
# undo the two pasted probes (unconnected probes would stop the simulation)
key Z ctrl
key Z ctrl
wait 4
dump 19d_undo_paste
# right drag pans; no menu
rdrag 0 -2 -3 -5
wait 6
dump 19e_rdrag
# properties dialog: wide value field
wmove 1.7 2.2
click left
wait 3
key Enter
wait 8
shot 19f_props
dump 19f_props
close_dialogs
key Escape
wait 3

# File > Settings: a double click on an empty spot opens quick add only when enabled (off by default)
fit
wait 10
wmove 9 -2
dblclick left
wait 6
dump 25_dbl_off
key Escape
wait 3
app_settings 15 150 1
wait 8
wmove 9 -2
dblclick left
wait 6
dump 26_dbl_on
close_dialogs
key Escape
wait 4
open_settings 1
wait 8
shot 27_settings
dump 27_settings
close_dialogs
app_settings 13 100 0
wait 8
# File > Export view: the whole schematic as a vector PDF
export_pdf schematic.pdf
wait 4
dump 28_export

# waveform viewer: blank single screen by default, math channel, FFT
run
wait 80
dump 20_wave_default
shot 20_wave_default
wave_add Vout
wave_color Vout e01060
wave_math P2 Vout*2
wait 6
wave_math BAD Vout+*
wait 6
dump 21_wave_math
shot 21_wave_math
wave_cursors 0.001 0.004
wave_fft Vout
wait 12
shot 22_fft
dump 22_fft
# the wheel over the FFT window must not zoom the waveform below it
movewin FFT 頻譜分析
scroll 240
wait 6
dump 23_fft_scroll
# control: the wheel over an uncovered part of the waveform plot zooms it
move 930 400
scroll 240
wait 6
dump 24_plot_scroll
# the signal list keeps its height when signals are added
dump 29_sig_before
wave_math P3 Vout*3
wait 6
dump 30_sig_after
# settings (fonts, line width) and the report (PDF, Excel) with cursor readings
wave_close_tools
wave_style 15 16 13 2.5
wave_settings 1
wait 10
shot 31_wave_settings
dump 31_wave_settings
wave_settings 0
wave_report report.pdf
wait 10
wave_report report.xlsx
wait 10
dump 32_report
# XY stretch tool: a left / right drag zooms the time axis, up / down the Y axis
wave_cursors_off
wave_tool stretch
wait 4
move 700 400
down left
move 720 400
move 760 400
move 800 400
wait 4
up left
wait 6
dump 33_stretch_x
move 700 400
down left
move 700 380
move 700 340
move 700 300
wait 4
up left
wait 6
dump 34_stretch_y
shot 34_stretch
# measurement columns chosen in the settings; every screen or only the selected one; more than four screens scroll
wave_tool zoom
wave_fit
wave_meas 1 Freq
wave_meas 2 DutyP
wave_meas 3 Rms
wave_meas 4 None
wave_screens 2
wave_select 1
wave_add P3
wait 6
dump 39_meas_all
wave_all meas 0
wave_all cur 0
wait 4
dump 40_meas_one
wave_all meas 1
wave_all cur 1
wave_screens 6
wave_select 5
wait 12
shot 41_six_screens
dump 41_six_screens
# report of every screen (PDF, Excel); waveform file saved, then opened again through the main window
wave_report report_all.pdf all
wait 10
wave_report report_all.xlsx all
wait 10
dump 42_report_all
wave_save wave
wait 4
dump 43_saved
wave_reset
wait 4
wave_open wave.dwave
wait 10
dump 44_reopened
shot 44_reopened
# element library: unpinned it hides to a tab on the left edge and slides out under the pointer
wave_close
close_dialogs
lib_pin 0
wait 8
dump 45_lib_hidden
menu lib_tab
wait 10
dump 46_lib_fly
shot 46_lib_fly
move 760 450
wait 60
dump 47_lib_closed
lib_pin 1
wait 6
dump 48_lib_pinned
# the user manual built into the program
manual_write manual.html
wait 2
# Monte Carlo: tolerances picked in the table of the properties dialog, then run (element parameters varied directly)
wave_close_tools
close_dialogs
place MONTECARLO 22 -4
wait 4
open_props_type MONTECARLO
wait 8
dump 35_mc_empty
mc rlc
wait 2
mc add Vs.Vm
wait 2
mc push R1
wait 8
dump 36_mc_rows
shot 36_mc_rows
mc remove 3
props_set n 4
props_set seed 3
wait 6
key Enter ctrl
wait 8
dump 37_mc_applied
run
wait 150
dump 38_mc_run
shot 38_mc_run
# a different circuit gets a waveform viewer window of its own; the first circuit keeps its results
load_example branches
wait 6
run
wait 150
dump 49_two_viewers
shot 49_two_viewers
quit
